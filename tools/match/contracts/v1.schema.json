{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/msetaro/aftershock/tools/match/contracts/v1.schema.json",
  "$defs": {
    "JoinTicket": {
      "type": "string",
      "maxLength": 256,
      "description": "Canonical v1.player_id.match_id.issued_at.expires_at.nonce.hmac_sha256; HMAC domain aftershock/join/v1 followed by newline. Lifetime at most 120 seconds; server enforces expected-player membership and one-use nonce.",
      "pattern": "^1\\.[1-9][0-9]{0,19}\\.[a-zA-Z0-9_-]{1,64}\\.[1-9][0-9]{0,11}\\.[1-9][0-9]{0,11}\\.[0-9a-f]{32}\\.[0-9a-f]{64}$"
    },
    "MatchSpec": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        },
        "map": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "maxLength": 48
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "rules": {
          "type": "object",
          "properties": {
            "frag_limit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "time_limit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            }
          },
          "required": [
            "frag_limit",
            "time_limit"
          ],
          "additionalProperties": false
        },
        "expected_players": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,19}$"
          }
        }
      },
      "required": [
        "version",
        "id",
        "map",
        "mode",
        "slots",
        "rules",
        "expected_players"
      ],
      "additionalProperties": false
    },
    "Loadout": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "primary": {
          "type": "string",
          "maxLength": 127,
          "pattern": "^weapons/[a-zA-Z0-9_-]+(/[a-zA-Z0-9_-]+)*\\.asweapon$"
        },
        "secondary": {
          "type": "string",
          "maxLength": 127,
          "pattern": "^weapons/[a-zA-Z0-9_-]+(/[a-zA-Z0-9_-]+)*\\.asweapon$"
        }
      },
      "required": [
        "version",
        "primary",
        "secondary"
      ],
      "additionalProperties": false
    },
    "MatchState": {
      "type": "object",
      "properties": {
        "accounts": {
          "type": "object",
          "maxProperties": 64,
          "patternProperties": {
            "^[1-9][0-9]{0,19}$": {
              "type": "object",
              "properties": {
                "kills": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "deaths": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "score": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                }
              },
              "required": [
                "kills",
                "deaths",
                "score"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "owners": {
          "type": "object",
          "maxProperties": 64,
          "patternProperties": {
            "^(?:[0-9]|[1-5][0-9]|6[0-3])$": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            }
          },
          "additionalProperties": false
        },
        "owner_scores": {
          "type": "object",
          "maxProperties": 64,
          "patternProperties": {
            "^(?:[0-9]|[1-5][0-9]|6[0-3])$": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          },
          "additionalProperties": false
        },
        "seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "players": {
          "type": [
            "object",
            "null"
          ],
          "maxProperties": 64,
          "patternProperties": {
            "^(?:[0-9]|[1-5][0-9]|6[0-3])$": {
              "type": "object",
              "properties": {
                "kills": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "deaths": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                }
              },
              "required": [
                "kills",
                "deaths"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "joins": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "kills": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "scores": {
          "type": [
            "object",
            "null"
          ],
          "maxProperties": 64,
          "patternProperties": {
            "^(?:[0-9]|[1-5][0-9]|6[0-3])$": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            }
          },
          "additionalProperties": false
        },
        "completed": {
          "type": "boolean"
        }
      },
      "required": [
        "seconds",
        "players",
        "joins",
        "kills",
        "scores",
        "completed"
      ],
      "additionalProperties": false
    },
    "MatchEvent": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "match_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8589934592
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        },
        "payload": {
          "type": "string",
          "maxLength": 5460,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "contentEncoding": "base64",
          "description": "Exact bytes of one newline-free native log record. Envelope time/type must agree with the decoded record."
        }
      },
      "required": [
        "version",
        "match_id",
        "sequence",
        "timestamp",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    "MatchCheckpoint": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "match_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8589934592
        },
        "state": {
          "$ref": "#/$defs/MatchState"
        }
      },
      "required": [
        "version",
        "match_id",
        "sequence",
        "state"
      ],
      "additionalProperties": false
    },
    "MatchBatch": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "match_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8589934592
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8589934592
        },
        "events": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/MatchEvent"
          }
        },
        "checkpoint": {
          "$ref": "#/$defs/MatchCheckpoint"
        },
        "final": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "match_id",
        "sequence",
        "end",
        "events",
        "checkpoint",
        "final"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/JoinTicket"
    },
    {
      "$ref": "#/$defs/MatchSpec"
    },
    {
      "$ref": "#/$defs/Loadout"
    },
    {
      "$ref": "#/$defs/MatchEvent"
    },
    {
      "$ref": "#/$defs/MatchCheckpoint"
    },
    {
      "$ref": "#/$defs/MatchBatch"
    }
  ]
}
