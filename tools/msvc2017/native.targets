<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Separate generated wrappers preserve the Make translation units and namespaces. -->
  <PropertyGroup>
    <NativeWrapper>$([System.String]::Copy('$(MSBuildThisFileDirectory)../../game/module.cpp').Replace('\', '/'))</NativeWrapper>
  </PropertyGroup>
  <ItemGroup>
    <NativeSource Include="game-ai_chat" Module="game" Define="QAGAME" Source="game/ai_chat.cpp" />
    <NativeSource Include="game-ai_cmd" Module="game" Define="QAGAME" Source="game/ai_cmd.cpp" />
