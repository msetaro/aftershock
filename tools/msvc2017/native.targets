    <NativeSource Include="ui-ui_confirm" Module="ui" Define="UI" Source="ui/ui_confirm.cpp" />
    <NativeSource Include="ui-ui_connect" Module="ui" Define="UI" Source="ui/ui_connect.cpp" />
    <NativeSource Include="ui-ui_controls2" Module="ui" Define="UI" Source="ui/ui_controls2.cpp" />
    <NativeSource Include="ui-ui_credits" Module="ui" Define="UI" Source="ui/ui_credits.cpp" />
    <NativeSource Include="ui-ui_demo2" Module="ui" Define="UI" Source="ui/ui_demo2.cpp" />
    <NativeSource Include="ui-ui_display" Module="ui" Define="UI" Source="ui/ui_display.cpp" />
    <NativeSource Include="ui-ui_gameinfo" Module="ui" Define="UI" Source="ui/ui_gameinfo.cpp" />
    <NativeSource Include="ui-ui_ingame" Module="ui" Define="UI" Source="ui/ui_ingame.cpp" />
    <NativeSource Include="ui-ui_loadconfig" Module="ui" Define="UI" Source="ui/ui_loadconfig.cpp" />
    <NativeSource Include="ui-ui_main" Module="ui" Define="UI" Source="ui/ui_main.cpp" Exports="#define NATIVE_EXPORTS &quot;ui/ui_native_exports.inc&quot;" />
    <NativeSource Include="ui-ui_menu" Module="ui" Define="UI" Source="ui/ui_menu.cpp" />
    <NativeSource Include="ui-ui_mfield" Module="ui" Define="UI" Source="ui/ui_mfield.cpp" />
    <NativeSource Include="ui-ui_mods" Module="ui" Define="UI" Source="ui/ui_mods.cpp" />
