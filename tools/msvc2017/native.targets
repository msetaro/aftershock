    <NativeSource Include="cgame-cg_main" Module="cgame" Define="CGAME" Source="cgame/cg_main.cpp" Exports="#define NATIVE_EXPORTS &quot;cgame/cg_native_exports.inc&quot;" />
    <NativeSource Include="cgame-cg_marks" Module="cgame" Define="CGAME" Source="cgame/cg_marks.cpp" />
    <NativeSource Include="cgame-cg_players" Module="cgame" Define="CGAME" Source="cgame/cg_players.cpp" />
    <NativeSource Include="cgame-cg_playerstate" Module="cgame" Define="CGAME" Source="cgame/cg_playerstate.cpp" />
    <NativeSource Include="cgame-cg_predict" Module="cgame" Define="CGAME" Source="cgame/cg_predict.cpp" />
    <NativeSource Include="cgame-cg_scoreboard" Module="cgame" Define="CGAME" Source="cgame/cg_scoreboard.cpp" />
    <NativeSource Include="cgame-cg_servercmds" Module="cgame" Define="CGAME" Source="cgame/cg_servercmds.cpp" />
    <NativeSource Include="cgame-cg_snapshot" Module="cgame" Define="CGAME" Source="cgame/cg_snapshot.cpp" />
    <NativeSource Include="cgame-cg_native" Module="cgame" Define="CGAME" Source="cgame/cg_native.cpp" />
    <NativeSource Include="cgame-cg_view" Module="cgame" Define="CGAME" Source="cgame/cg_view.cpp" />
    <NativeSource Include="cgame-cg_weapons" Module="cgame" Define="CGAME" Source="cgame/cg_weapons.cpp" />
    <NativeSource Include="cgame-q_math" Module="cgame" Define="CGAME" Source="bg/q_math.cpp" />
    <NativeSource Include="cgame-q_shared" Module="cgame" Define="CGAME" Source="bg/q_shared.cpp" />
    <NativeSource Include="cgame-bg_lib" Module="cgame" Define="CGAME" Source="bg/bg_lib.cpp" />
  </ItemGroup>
  <ItemGroup Condition="'$(ProjectName)' != 'quake3e-ded'">
