    <NativeSource Include="game-bg_lib" Module="game" Define="QAGAME" Source="bg/bg_lib.cpp" />
  </ItemGroup>
  <ItemGroup Condition="'$(ProjectName)' != 'quake3e-ded'">
    <NativeSource Include="cgame-bg_misc" Module="cgame" Define="CGAME" Source="bg/bg_misc.cpp" />
    <NativeSource Include="cgame-bg_pmove" Module="cgame" Define="CGAME" Source="bg/bg_pmove.cpp" />
    <NativeSource Include="cgame-bg_slidemove" Module="cgame" Define="CGAME" Source="bg/bg_slidemove.cpp" />
