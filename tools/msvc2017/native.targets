    <NativeSource Include="ui-ui_playermodel" Module="ui" Define="UI" Source="ui/ui_playermodel.cpp" />
    <NativeSource Include="ui-ui_players" Module="ui" Define="UI" Source="ui/ui_players.cpp" />
    <NativeSource Include="ui-ui_playersettings" Module="ui" Define="UI" Source="ui/ui_playersettings.cpp" />
    <NativeSource Include="ui-ui_preferences" Module="ui" Define="UI" Source="ui/ui_preferences.cpp" />
