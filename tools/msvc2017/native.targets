    <NativeSource Include="game-g_items" Module="game" Define="QAGAME" Source="game/g_items.cpp" />
    <NativeSource Include="game-g_main" Module="game" Define="QAGAME" Source="game/g_main.cpp" Exports="#define NATIVE_EXPORTS &quot;game/g_native_exports.inc&quot;" />
    <NativeSource Include="game-g_mem" Module="game" Define="QAGAME" Source="game/g_mem.cpp" />
    <NativeSource Include="game-g_misc" Module="game" Define="QAGAME" Source="game/g_misc.cpp" />
