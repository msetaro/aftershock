    <NativeSource Include="ui-q_shared" Module="ui" Define="UI" Source="bg/q_shared.cpp" />
    <NativeSource Include="ui-bg_lib" Module="ui" Define="UI" Source="bg/bg_lib.cpp" />
  </ItemGroup>
  <Target Name="PrepareNativeSources" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(IntDir)native" />
    <WriteLinesToFile File="$(IntDir)native\%(NativeSource.Identity).cpp"
      Lines="#define NATIVE_NAMESPACE %(NativeSource.Module);#define %(NativeSource.Define);#define NATIVE_SOURCE &quot;%(NativeSource.Source)&quot;;%(NativeSource.Exports);#include &quot;$(NativeWrapper)&quot;"
      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <ClCompile Include="@(NativeSource->'$(IntDir)native\%(Identity).cpp')">
        <ObjectFileName>$(IntDir)native\%(Filename).obj</ObjectFileName>
        <PrecompiledHeader>NotUsing</PrecompiledHeader>
        <FloatingPointModel>Strict</FloatingPointModel>
        <IntrinsicFunctions>false</IntrinsicFunctions>
        <AdditionalOptions>%(ClCompile.AdditionalOptions) /Zc:strictStrings</AdditionalOptions>
      </ClCompile>
    </ItemGroup>
  </Target>
</Project>
