    <NativeSource Include="ui-ui_servers2" Module="ui" Define="UI" Source="ui/ui_servers2.cpp" />
    <NativeSource Include="ui-ui_setup" Module="ui" Define="UI" Source="ui/ui_setup.cpp" />
    <NativeSource Include="ui-ui_sound" Module="ui" Define="UI" Source="ui/ui_sound.cpp" />
    <NativeSource Include="ui-ui_sparena" Module="ui" Define="UI" Source="ui/ui_sparena.cpp" />
    <NativeSource Include="ui-ui_specifyserver" Module="ui" Define="UI" Source="ui/ui_specifyserver.cpp" />
