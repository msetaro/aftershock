    <NativeSource Include="game-g_svcmds" Module="game" Define="QAGAME" Source="game/g_svcmds.cpp" />
    <NativeSource Include="game-g_native" Module="game" Define="QAGAME" Source="game/g_native.cpp" />
    <NativeSource Include="game-g_target" Module="game" Define="QAGAME" Source="game/g_target.cpp" />
    <NativeSource Include="game-g_team" Module="game" Define="QAGAME" Source="game/g_team.cpp" />
    <NativeSource Include="game-g_trigger" Module="game" Define="QAGAME" Source="game/g_trigger.cpp" />
    <NativeSource Include="game-g_utils" Module="game" Define="QAGAME" Source="game/g_utils.cpp" />
