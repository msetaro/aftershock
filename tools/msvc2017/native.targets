    <NativeSource Include="ui-ui_team" Module="ui" Define="UI" Source="ui/ui_team.cpp" />
    <NativeSource Include="ui-ui_teamorders" Module="ui" Define="UI" Source="ui/ui_teamorders.cpp" />
    <NativeSource Include="ui-ui_video" Module="ui" Define="UI" Source="ui/ui_video.cpp" />
